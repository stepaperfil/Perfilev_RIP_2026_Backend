{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Веб-сервис расчёта стоимости владения активом: этапы жизненного цикла и пользователи.",
        "title": "TCO API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/engineers": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "engineers"
                ],
                "summary": "Регистрация пользователя",
                "parameters": [
                    {
                        "description": "Данные пользователя",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/serializer.RegisterEngineerRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/serializer.Engineer"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "409": {
                        "description": "Conflict"
                    }
                }
            }
        },
        "/api/engineers/login": {
            "post": {
                "description": "Проверяет логин и пароль и возвращает JWT для заголовка Authorization: Bearer \u003ctoken\u003e.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "engineers"
                ],
                "summary": "Аутентификация",
                "parameters": [
                    {
                        "description": "Логин и пароль",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/serializer.LoginEngineerRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/serializer.LoginEngineerResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
        "/api/engineers/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Добавляет текущий JWT в блеклист Redis до окончания срока его действия.",
                "tags": [
                    "engineers"
                ],
                "summary": "Деавторизация",
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
        "/api/life_cycle_stages": {
            "get": {
                "description": "Опубликованные этапы с фильтром по цене за единицу. Доступно гостю.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "life_cycle_stages"
                ],
                "summary": "Список этапов жизненного цикла",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Максимальная цена за единицу",
                        "name": "max_price_per_unit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/serializer.LifeCycleStageListItem"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Создаёт черновик этапа текущего пользователя, фото и видео загружаются в MinIO.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "life_cycle_stages"
                ],
                "summary": "Добавление этапа",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Название",
                        "name": "title",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Изображение",
                        "name": "image",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Видео",
                        "name": "video",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/serializer.LifeCycleStage"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "409": {
                        "description": "Conflict"
                    }
                }
            }
        },
        "/api/life_cycle_stages/draft": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "life_cycle_stages"
                ],
                "summary": "Черновик текущего пользователя",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/serializer.LifeCycleStage"
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        },
        "/api/life_cycle_stages/feed": {
            "get": {
                "description": "Без id - первый этап ленты, с id - этот этап, с id и next=true - следующий за ним. Доступно гостю.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "life_cycle_stages"
                ],
                "summary": "Лента этапов",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID этапа",
                        "name": "id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "true - следующий этап",
                        "name": "next",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/serializer.LifeCycleStageFeedItem"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        },
        "/api/life_cycle_stages/{id}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Логическое удаление этапа текущего пользователя.",
                "tags": [
                    "life_cycle_stages"
                ],
                "summary": "Удаление этапа",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID этапа",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        },
        "/api/life_cycle_stages/{id}/like": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "like = 1 ставит лайк текущего пользователя, like = 0 снимает его.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "life_cycle_stages"
                ],
                "summary": "Лайк этапа",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID этапа",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Лайк",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/serializer.LikeLifeCycleStageRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/serializer.LifeCycleStageFeedItem"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        },
        "/api/life_cycle_stages/{id}/publish": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "life_cycle_stages"
                ],
                "summary": "Публикация черновика этапа",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID этапа",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Данные публикации",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/serializer.PublishLifeCycleStageRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/serializer.LifeCycleStage"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        }
    },
    "definitions": {
        "serializer.Engineer": {
            "type": "object",
            "properties": {
                "full_name": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "login": {
                    "type": "string"
                }
            }
        },
        "serializer.LifeCycleStage": {
            "type": "object",
            "properties": {
                "creator_id": {
                    "type": "integer"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "image_url": {
                    "type": "string"
                },
                "price_per_unit": {
                    "type": "integer"
                },
                "stage_position": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "serializer.LifeCycleStageFeedItem": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "image_url": {
                    "type": "string"
                },
                "is_liked": {
                    "type": "integer"
                },
                "likes_count": {
                    "type": "integer"
                },
                "price_per_unit": {
                    "type": "integer"
                },
                "stage_position": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "serializer.LifeCycleStageListItem": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "image_url": {
                    "type": "string"
                },
                "is_mine": {
                    "type": "integer"
                },
                "likes_count": {
                    "type": "integer"
                },
                "price_per_unit": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "serializer.LikeLifeCycleStageRequest": {
            "type": "object",
            "required": [
                "like"
            ],
            "properties": {
                "like": {
                    "type": "integer",
                    "enum": [
                        0,
                        1
                    ]
                }
            }
        },
        "serializer.LoginEngineerRequest": {
            "type": "object",
            "required": [
                "login",
                "password"
            ],
            "properties": {
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "serializer.LoginEngineerResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_in": {
                    "type": "integer"
                },
                "token_type": {
                    "type": "string"
                }
            }
        },
        "serializer.PublishLifeCycleStageRequest": {
            "type": "object",
            "required": [
                "description",
                "price_per_unit",
                "stage_position"
            ],
            "properties": {
                "description": {
                    "type": "string"
                },
                "price_per_unit": {
                    "type": "integer",
                    "minimum": 0
                },
                "stage_position": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "serializer.RegisterEngineerRequest": {
            "type": "object",
            "required": [
                "full_name",
                "login",
                "password"
            ],
            "properties": {
                "full_name": {
                    "type": "string",
                    "maxLength": 150
                },
                "login": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 3
                },
                "password": {
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 6
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Введите \"Bearer \u003cтокен из /api/engineers/login\u003e\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}